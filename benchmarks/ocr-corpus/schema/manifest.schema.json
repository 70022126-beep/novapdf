{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapdf.local/schemas/ocr-corpus-manifest-v1.json",
  "title": "NovaPDF private OCR corpus manifest",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "quotas", "samples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "renderDpi": { "type": "integer", "minimum": 96, "maximum": 600 },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "quotas": {
      "type": "object",
      "required": ["clean_scan", "noisy_scan", "form_table", "hybrid"],
      "properties": {
        "clean_scan": { "type": "integer", "minimum": 30 },
        "noisy_scan": { "type": "integer", "minimum": 30 },
        "form_table": { "type": "integer", "minimum": 20 },
        "hybrid": { "type": "integer", "minimum": 20 }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "category", "categoryReview", "sourcePdf", "page", "image", "annotation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "category": { "enum": ["clean_scan", "noisy_scan", "form_table", "hybrid"] },
          "categoryReview": { "enum": ["pending", "human_verified"] },
          "sourcePdf": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "rotation": { "enum": [0, 90, 180, 270] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "image": { "type": "string", "minLength": 1 },
          "annotation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
